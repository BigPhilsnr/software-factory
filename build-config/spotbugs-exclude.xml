<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs / FindSecBugs exclusions shared by factory/ and shortener/.
  Keep this file minimal: every entry needs a justification, and a finding in one place should be
  suppressed at that place (@SuppressFBWarnings is not on the classpath, so use a narrow <Match> with
  <Class>/<Method>) rather than by widening a pattern here.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
    <!-- These constructors intentionally share scoped service collaborators. Copying them would break
         checkpoint persistence and the per-run Git service; neither exposes a mutable data collection. -->
    <Match>
        <Class name="dev.softwarefactory.candidate.DraftWorkspace"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="dev.softwarefactory.generation.tools.DraftTools"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
