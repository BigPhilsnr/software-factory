# Copy this file to .env and replace the placeholder with your Anthropic API key.
ANTHROPIC_API_KEY=replace-with-your-key
# Optional model override. The default is configured in RunEngine.
# CLAUDE_MODEL=claude-sonnet-4-5

# Local-only database defaults. Set different passwords before creating fresh volumes.
# Existing PostgreSQL volumes require ALTER ROLE to rotate passwords; changing this file alone does not rotate them.
SHORTENER_DB_PASSWORD=shortener
CONTROL_DB_PASSWORD=control
# Shared daily chat request cap, persisted in the control DB (not a dollar budget).
FACTORY_CHAT_DAILY_REQUESTS=80
