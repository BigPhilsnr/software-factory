# Copy this file to .env. The launchers in scripts/ and compose.yaml read it. Maven does not.
#
# Rules of this file:
#   - NAME=value, one per line. Lines starting with # are ignored.
#   - Only the variable names shown below are accepted. Any other name stops the launchers
#     with "Invalid .env entry".
#   - A variable already exported in your shell wins over the value here.
#   - Never commit .env. It is ignored by Git.

# ---------------------------------------------------------------------------
# Factory: live generation (not needed for fixture runs)
# ---------------------------------------------------------------------------

# Anthropic API key. Required for live runs and chat answers. Paid calls.
ANTHROPIC_API_KEY=replace-with-your-key

# Secret for the audit-chain HMAC, at least 32 characters. Required for live runs.
# Generate one with: openssl rand -hex 32
# Keep it stable: changing it makes existing audit chains fail verification.
# Without it, fixture runs use a development key created in .runs/audit.key.
FACTORY_AUDIT_KEY=


# Model used for tasks, chat and web search. Default: claude-sonnet-4-5 (FactorySettings).
CLAUDE_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Factory: limits (defaults shown)
# ---------------------------------------------------------------------------

# Provider requests allowed per run, 1..100. This is a request count, not a cost limit.
# FACTORY_MAX_MODEL_CALLS=24

# Provider requests allowed for chat per UTC day, 1..10000. Stored in the control database.
FACTORY_CHAT_DAILY_REQUESTS=80

# Deadline for one task generation, in seconds, 1..3600.
# FACTORY_RUN_DEADLINE_SECONDS=900

# Deadline for one chat answer, in seconds, 1..3600.
# FACTORY_CHAT_DEADLINE_SECONDS=180

# Name written into approval, clarification and revision audit events. Default: your OS user name.
# It is a label, not an identity check.
# FACTORY_OPERATOR=your-name

# Maven repository mounted read-only into the validation sandbox. Default: ~/.m2/repository
# FACTORY_MAVEN_REPOSITORY=/absolute/path/to/.m2/repository

# ---------------------------------------------------------------------------
# Control database (factory). Local demonstration defaults.
# ---------------------------------------------------------------------------

# CONTROL_DB_URL=jdbc:postgresql://localhost:5434/control
# CONTROL_DB_USER=control
# Also used by compose.yaml when the control-db volume is first created.
CONTROL_DB_PASSWORD=control

# ---------------------------------------------------------------------------
# Shortener
# ---------------------------------------------------------------------------

# HTTP port. Default: 8080
# SHORTENER_PORT=8080

# Prefix of returned short URLs. Its host is also refused as a link target. Default: http://localhost:8080
# SHORTENER_BASE_URL=http://localhost:8080

# SHORTENER_DB_URL=jdbc:postgresql://localhost:5433/shortener
# SHORTENER_DB_USER=shortener
# Also used by compose.yaml when the shortener-db volume is first created.
SHORTENER_DB_PASSWORD=shortener

# ---------------------------------------------------------------------------
# Database passwords: choose your own before creating the volumes. PostgreSQL stores the
# password when a volume is first created. Changing it here later does not change the stored
# role; use ALTER ROLE inside the container, or recreate the volume.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shell-only variables. Do NOT put these in .env (the launchers reject them); export them.
# ---------------------------------------------------------------------------
#   JAVA_HOME                           JDK 21 or newer (21 to 25 for "mvn verify")
#   SHORTENER_FORWARD_HEADERS_STRATEGY  none (default) | native | framework. Set only behind a
#                                       trusted proxy that overwrites X-Forwarded-For.
#   SHORTENER_TEST_DB_URL / _USER / _PASSWORD
#                                       Shortener integration tests; fall back to SHORTENER_DB_*.
#   FACTORY_TEST_URL                    Target of web_smoke.py and browser_smoke.cjs.
#                                       Default: http://localhost:8000
#   CHROME_PATH, FACTORY_BROWSER_MODULE browser_smoke.cjs only.
